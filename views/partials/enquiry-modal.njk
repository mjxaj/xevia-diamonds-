<div id="enquiry-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
  <div class="bg-[#FFF8F0] max-w-xl w-full shadow-2xl relative my-auto">
    <button data-close-modal class="absolute top-4 right-4 p-2 text-[#444] hover:text-[#101010] transition-colors z-10">
      <span class="material-symbols-outlined">close</span>
    </button>

    <div data-modal-result class="hidden"></div>

    <div data-modal-form-wrap class="p-10 md:p-12">
      <p class="text-primary text-[10px] tracking-[0.3em] uppercase font-bold mb-3">Private Atelier</p>
      <h3 data-modal-title class="text-3xl md:text-4xl font-headline italic mb-2">Enquire Now</h3>
      <p data-product-name class="text-primary text-xs tracking-[0.2em] uppercase font-bold mb-8"></p>

      <form class="space-y-5">
        <input type="hidden" name="product_slug" value="" />
        <input type="hidden" name="product_id" value="" />
        <input type="hidden" name="enquiry_type" value="product" />

        <div>
          <label class="block text-[10px] tracking-[0.25em] uppercase font-bold text-[#444] mb-2">Full Name *</label>
          <input name="name" required type="text" class="w-full bg-transparent border-b border-[#E0D9CF] px-1 py-3 focus:border-primary focus:ring-0 text-sm"/>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <label class="block text-[10px] tracking-[0.25em] uppercase font-bold text-[#444] mb-2">Email *</label>
            <input name="email" required type="email" class="w-full bg-transparent border-b border-[#E0D9CF] px-1 py-3 focus:border-primary focus:ring-0 text-sm"/>
          </div>
          <div>
            <label class="block text-[10px] tracking-[0.25em] uppercase font-bold text-[#444] mb-2">Phone</label>
            <input name="phone" type="tel" class="w-full bg-transparent border-b border-[#E0D9CF] px-1 py-3 focus:border-primary focus:ring-0 text-sm"/>
          </div>
        </div>
        <div>
          <label class="block text-[10px] tracking-[0.25em] uppercase font-bold text-[#444] mb-2">Budget Range</label>
          <select name="budget" class="w-full bg-transparent border-b border-[#E0D9CF] px-1 py-3 focus:border-primary focus:ring-0 text-sm">
            <option value="">— Select —</option>
            <option>Below ₹50,000</option>
            <option>₹50,000 – ₹2,00,000</option>
            <option>₹2,00,000 – ₹5,00,000</option>
            <option>₹5,00,000 – ₹10,00,000</option>
            <option>Above ₹10,00,000</option>
            <option>Price on application</option>
          </select>
        </div>
        <div>
          <label class="block text-[10px] tracking-[0.25em] uppercase font-bold text-[#444] mb-2">Message</label>
          <textarea name="message" rows="4" placeholder="Tell us about the piece, occasion or preferences" class="w-full bg-transparent border-b border-[#E0D9CF] px-1 py-3 focus:border-primary focus:ring-0 text-sm resize-none"></textarea>
        </div>

        <button type="submit" class="w-full gold-gradient text-white py-4 text-xs tracking-[0.3em] uppercase font-bold hover:scale-[1.01] transition-transform shadow-md mt-6">
          Submit Enquiry
        </button>
        <p class="text-center text-[10px] text-[#444]/70 tracking-wider">
          Our atelier will respond within 24 hours.
        </p>
      </form>
    </div>
  </div>
</div>

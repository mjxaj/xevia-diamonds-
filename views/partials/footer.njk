<footer class="bg-[#FFF8F0] border-t border-[#E0D9CF] mt-20 md:mt-32">
  <section class="py-16 md:py-24 border-b border-[#E0D9CF]">
    <div class="max-w-3xl mx-auto px-5 sm:px-6 text-center">
      <h2 class="text-3xl sm:text-4xl font-headline mb-4 md:mb-6">{{ settings.newsletter_heading | default('Join the Private Circle') }}</h2>
      <p class="text-[#444] text-sm md:text-base mb-8 md:mb-10">{{ settings.newsletter_body | default('Receive exclusive invitations to private viewings and early access.') }}</p>
      <form action="/subscribe" method="POST" class="flex flex-col md:flex-row gap-3 md:gap-4">
        <input name="email" required type="email" placeholder="YOUR EMAIL ADDRESS" class="flex-grow bg-transparent border-b border-[#E0D9CF] text-[#101010] placeholder:text-[#444]/50 focus:border-primary focus:ring-0 px-3 md:px-4 py-3 md:py-4 text-xs tracking-widest uppercase transition-colors text-center md:text-left"/>
        <button class="bg-primary text-white px-8 md:px-10 py-3 md:py-4 font-bold text-xs tracking-widest uppercase hover:bg-[#a88563] transition-colors shadow-md">Subscribe</button>
      </form>
    </div>
  </section>
  <div class="max-w-7xl mx-auto px-5 sm:px-6 py-12 md:py-16 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
    <div class="col-span-2 md:col-span-1">
      <div class="text-xl font-serif tracking-[0.3em] uppercase mb-3 md:mb-4">{{ site.name }}</div>
      <p class="text-sm text-[#444] font-light leading-relaxed">{{ site.tagline }}<br/>Est. {{ site.established }}</p>
    </div>
    <div>
      <h4 class="text-[10px] tracking-[0.3em] uppercase font-bold mb-3 md:mb-4 text-primary">Atelier</h4>
      <ul class="space-y-2 text-sm text-[#444]">
        <li><a href="/collections" class="hover:text-primary">Collections</a></li>
        <li><a href="/portfolio" class="hover:text-primary">Portfolio</a></li>
        <li><a href="/imagine" class="hover:text-primary">Imagine</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-[10px] tracking-[0.3em] uppercase font-bold mb-3 md:mb-4 text-primary">House</h4>
      <ul class="space-y-2 text-sm text-[#444]">
        <li><a href="/about" class="hover:text-primary">Our Story</a></li>
        <li><a href="/contact" class="hover:text-primary">Contact</a></li>
        <li><button data-enquire data-title="Private Concierge" class="hover:text-primary text-left">Private Concierge</button></li>
      </ul>
    </div>
    <div class="col-span-2 md:col-span-1">
      <h4 class="text-[10px] tracking-[0.3em] uppercase font-bold mb-3 md:mb-4 text-primary">Contact</h4>
      <ul class="space-y-2 text-sm text-[#444]">
        {% if site.contact_email %}<li><a href="mailto:{{ site.contact_email }}" class="hover:text-primary break-all">{{ site.contact_email }}</a></li>{% endif %}
        {% if site.contact_phone %}<li><a href="tel:{{ site.contact_phone }}" class="hover:text-primary">{{ site.contact_phone }}</a></li>{% endif %}
        {% if site.contact_address %}<li>{{ site.contact_address }}</li>{% endif %}
      </ul>
    </div>
  </div>
  <div class="border-t border-[#E0D9CF] py-4 px-4 flex flex-col md:flex-row items-center justify-center gap-3 md:gap-6 text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-[#444]/70">
    <a href="/privacy-policy" class="hover:text-primary">Privacy Policy</a>
    <span class="hidden md:inline">·</span>
    <a href="/terms-conditions" class="hover:text-primary">Terms &amp; Conditions</a>
    <span class="hidden md:inline">·</span>
    <a href="/refund-policy" class="hover:text-primary">Refund Policy</a>
    <span class="hidden md:inline">·</span>
    <a href="/shipping-policy" class="hover:text-primary">Shipping Policy</a>
  </div>
  <div class="border-t border-[#E0D9CF] py-5 md:py-6 px-4 text-center text-[9px] sm:text-[10px] tracking-[0.3em] uppercase text-[#444]/60">
    &copy; {{ site.name }} — {{ site.established }} · All rights reserved
  </div>
</footer>

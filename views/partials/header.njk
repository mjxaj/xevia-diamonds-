<header class="fixed top-0 w-full z-40 flex justify-between items-center px-4 sm:px-8 h-16 sm:h-20 glass-panel border-b border-[#E8DCC8]/60">
  <a href="/" class="flex flex-col items-start leading-none">
    <span class="text-xl sm:text-2xl font-serif tracking-[0.18em] sm:tracking-[0.2em] text-[#1a1208] uppercase">{{ site.name }}</span>
    <span class="text-[8px] sm:text-[9px] tracking-[0.45em] uppercase text-[#a88563] font-semibold mt-1">Diamonds</span>
  </a>
  <nav class="hidden md:flex items-center gap-8 lg:gap-10 text-[10px] tracking-[0.3em] uppercase font-semibold text-[#1a1208]">
    <a href="/collections" class="hover:text-primary transition-colors {% if currentPath.startsWith('/collections') %}text-primary{% endif %}">Collections</a>
    <a href="/collections/studs" class="hover:text-primary transition-colors">Engagement</a>
    <a href="/portfolio" class="hover:text-primary transition-colors {% if currentPath == '/portfolio' %}text-primary{% endif %}">Fine Jewellery</a>
    <a href="/about" class="hover:text-primary transition-colors {% if currentPath == '/about' %}text-primary{% endif %}">Our Story</a>
    <a href="/imagine" class="hover:text-primary transition-colors {% if currentPath == '/imagine' %}text-primary{% endif %}">Journal</a>
  </nav>
  <button data-enquire data-title="Book a Private Consultation" class="hidden md:inline-flex items-center gap-2 px-5 py-3 bg-[#b8956a] hover:bg-[#a88563] text-white text-[10px] tracking-[0.3em] uppercase font-bold shadow-md transition-all">
    Book Consultation
    <span class="material-symbols-outlined text-base">add</span>
  </button>
  <button aria-label="Open menu" class="md:hidden p-2 text-[#101010]" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
    <span class="material-symbols-outlined">menu</span>
  </button>
</header>

<div id="mobile-menu" class="hidden md:hidden fixed top-16 left-0 w-full z-40 glass-panel border-b border-[#E0D9CF] py-5 sm:py-6">
  <nav class="flex flex-col gap-4 px-8 text-sm tracking-[0.25em] uppercase font-semibold">
    <a href="/collections">Collections</a>
    <a href="/portfolio">Portfolio</a>
    <a href="/imagine">Imagine</a>
    <a href="/about">Atelier</a>
    <a href="/contact">Contact</a>
    <button data-enquire data-title="Enquire Now" class="mt-4 px-6 py-3 gold-gradient text-white text-[10px] tracking-[0.3em] uppercase font-bold">Enquire Now</button>
  </nav>
</div>

<div class="h-16 sm:h-20"></div>

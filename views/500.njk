{% extends '_base.njk' %}
{% block content %}
<section class="py-40 text-center px-6">
  <p class="text-primary text-[10px] tracking-[0.3em] uppercase font-bold">Apologies</p>
  <h1 class="text-5xl md:text-7xl font-headline italic mt-4 mb-6">Something went wrong</h1>
  {% if error %}<p class="text-[#444] font-mono text-xs mb-10">{{ error }}</p>{% endif %}
  <a href="/" class="px-10 py-4 gold-gradient text-white font-bold text-xs tracking-[0.3em] uppercase shadow-md">Return to the Atelier</a>
</section>
{% endblock %}

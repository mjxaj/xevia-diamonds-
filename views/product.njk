{% extends '_base.njk' %}
{% block content %}
<section class="py-12 px-6 max-w-7xl mx-auto">
  <nav class="text-[10px] tracking-[0.3em] uppercase font-bold text-[#444] mb-12">
    <a href="/" class="hover:text-primary">Atelier</a>
    <span class="mx-3">›</span>
    {% if product.collection_slug %}<a href="/collections/{{ product.collection_slug }}" class="hover:text-primary">{{ product.collection_name }}</a><span class="mx-3">›</span>{% endif %}
    <span class="text-primary">{{ product.name }}</span>
  </nav>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
    <div class="aspect-[4/5] bg-white border border-[#E0D9CF] overflow-hidden">
      {% if product.primary_image %}<img src="{{ product.primary_image }}" alt="{{ product.name }}" class="w-full h-full object-cover"/>{% endif %}
    </div>
    <div class="py-4">
      {% if product.collection_name %}<p class="text-primary text-[10px] tracking-[0.3em] uppercase font-bold">{{ product.collection_name }}</p>{% endif %}
      <h1 class="text-4xl md:text-6xl font-headline italic mt-4 mb-6">{{ product.name }}</h1>
      <p class="text-[#444] font-light leading-relaxed text-lg mb-10">{{ product.description }}</p>

      <dl class="border-t border-[#E0D9CF] divide-y divide-[#E0D9CF] mb-10">
        {% if product.metal %}<div class="grid grid-cols-3 py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Metal</dt><dd class="col-span-2 text-sm">{{ product.metal }}</dd></div>{% endif %}
        {% if product.stones %}<div class="grid grid-cols-3 py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Stones</dt><dd class="col-span-2 text-sm">{{ product.stones }}</dd></div>{% endif %}
        {% if product.carat_weight %}<div class="grid grid-cols-3 py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Carat Weight</dt><dd class="col-span-2 text-sm">{{ product.carat_weight }}</dd></div>{% endif %}
        {% if product.dimensions %}<div class="grid grid-cols-3 py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Dimensions</dt><dd class="col-span-2 text-sm">{{ product.dimensions }}</dd></div>{% endif %}
        {% if product.price_range %}<div class="grid grid-cols-3 py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Investment</dt><dd class="col-span-2 text-sm font-bold">{{ product.price_range }}</dd></div>{% endif %}
      </dl>

      <button data-enquire
        data-product-name="{{ product.name }}"
        data-product-slug="{{ product.slug }}"
        data-product-id="{{ product.id }}"
        data-title="Enquire about {{ product.name }}"
        class="w-full md:w-auto px-12 py-5 gold-gradient text-white font-bold text-xs tracking-[0.3em] uppercase shadow-lg hover:scale-[1.02] transition-transform">
        Enquire Now
      </button>

      <div class="flex items-center gap-8 mt-10 text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">
        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-base">verified</span> Certified</div>
        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-base">handyman</span> Hand-finished</div>
        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-base">eco</span> Ethical</div>
      </div>
    </div>
  </div>
</section>

{% if related.length %}
<section class="py-32 bg-surface-container-low border-y border-[#E0D9CF]">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl md:text-5xl font-headline italic mb-16">You may also love</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {% for p in related %}
      <a href="/products/{{ p.slug }}" class="group block">
        <div class="aspect-[4/5] overflow-hidden bg-white border border-[#E0D9CF]">
          {% if p.primary_image %}<img src="{{ p.primary_image }}" alt="{{ p.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"/>{% endif %}
        </div>
        <h3 class="text-xl font-headline italic mt-6">{{ p.name }}</h3>
        <p class="text-primary text-[10px] tracking-[0.3em] uppercase mt-3 font-bold">View →</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endblock %}

{% extends '_base.njk' %}
{% block content %}
<section class="py-8 md:py-12 px-5 sm:px-6 max-w-7xl mx-auto">
  <nav class="text-[9px] sm:text-[10px] tracking-[0.25em] sm:tracking-[0.3em] uppercase font-bold text-[#444] mb-8 md:mb-12 flex flex-wrap items-center gap-y-1">
    <a href="/" class="hover:text-primary">Atelier</a>
    <span class="mx-2 sm:mx-3">›</span>
    {% if product.collection_slug %}<a href="/collections/{{ product.collection_slug }}" class="hover:text-primary">{{ product.collection_name }}</a><span class="mx-2 sm:mx-3">›</span>{% endif %}
    <span class="text-primary truncate max-w-[180px] sm:max-w-none">{{ product.name }}</span>
  </nav>

  {% set gallery_list = [] %}
  {% if product.gallery %}{% set gallery_list = product.gallery | parseJson %}{% endif %}
  {% if gallery_list.length == 0 and product.primary_image %}{% set gallery_list = [product.primary_image] %}{% endif %}

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-start">
    <div data-carousel class="relative">
      <div class="aspect-[4/5] bg-white border border-[#E0D9CF] overflow-hidden relative cursor-zoom-in" data-carousel-zoom>
        {% for img in gallery_list %}
        <img src="{{ img }}" alt="{{ product.name }} — view {{ loop.index }}"
             data-slide="{{ loop.index0 }}"
             class="absolute inset-0 w-full h-full object-cover transition-opacity duration-500 {% if loop.index0 == 0 %}opacity-100{% else %}opacity-0{% endif %}"/>
        {% endfor %}
        <div class="absolute top-3 right-3 w-9 h-9 glass-panel border border-[#E0D9CF] flex items-center justify-center pointer-events-none z-[5]">
          <span class="material-symbols-outlined text-[18px]">zoom_in</span>
        </div>
      </div>

      {% if gallery_list.length > 1 %}
      <button type="button" data-carousel-prev aria-label="Previous"
        class="absolute left-2 sm:left-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 glass-panel border border-[#E0D9CF] flex items-center justify-center hover:bg-white transition-colors z-10">
        <span class="material-symbols-outlined text-[20px] sm:text-[24px]">chevron_left</span>
      </button>
      <button type="button" data-carousel-next aria-label="Next"
        class="absolute right-2 sm:right-3 top-1/2 -translate-y-1/2 w-9 h-9 sm:w-11 sm:h-11 glass-panel border border-[#E0D9CF] flex items-center justify-center hover:bg-white transition-colors z-10">
        <span class="material-symbols-outlined text-[20px] sm:text-[24px]">chevron_right</span>
      </button>

      <div class="flex justify-center gap-3 mt-5 md:mt-6">
        {% for img in gallery_list %}
        <button type="button" data-carousel-dot="{{ loop.index0 }}"
          class="w-8 h-[2px] transition-colors {% if loop.index0 == 0 %}bg-primary{% else %}bg-[#E0D9CF]{% endif %}"
          aria-label="View {{ loop.index }}"></button>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    <div class="py-2 md:py-4" data-product-card>
      {% if product.collection_name %}<p class="text-primary text-[10px] tracking-[0.3em] uppercase font-bold">{{ product.collection_name }}</p>{% endif %}
      <h1 class="text-3xl sm:text-4xl md:text-6xl font-headline italic mt-3 md:mt-4 mb-3 leading-tight">{{ product.name }}</h1>
      <p class="text-[10px] tracking-[0.3em] uppercase font-bold text-[#666] mb-5">SKU · XEV-{{ '%04d' % product.id }}</p>
      <p class="text-[#444] font-light leading-relaxed text-base md:text-lg mb-8">{{ product.description }}</p>

      {% if product.price_range %}
      <div class="flex items-baseline gap-3 mb-8">
        <span class="text-2xl md:text-3xl font-headline text-[#1a1208]">{{ product.price_range }}</span>
      </div>
      {% endif %}

      <!-- Metal selector -->
      <div class="mb-8">
        <p class="text-[10px] tracking-[0.3em] uppercase font-bold text-[#444] mb-3">Metal</p>
        <div class="flex items-center gap-3" data-metal-selector>
          {% for m in [
            ['yellow', 'Yellow Gold', 'linear-gradient(135deg, #d4af6a 0%, #b8956a 100%)'],
            ['white', 'White Gold', 'linear-gradient(135deg, #e8e6e1 0%, #c9c5be 100%)'],
            ['rose', 'Rose Gold', 'linear-gradient(135deg, #e0b4a0 0%, #c98a72 100%)']
          ] %}
          <button type="button" data-metal="{{ m[0] }}" data-metal-label="{{ m[1] }}"
            class="metal-chip group flex flex-col items-center gap-2 {% if loop.index == 1 %}is-active{% endif %}">
            <span class="w-10 h-10 rounded-full border-2 transition-all {% if loop.index == 1 %}border-[#1a1208]{% else %}border-transparent group-hover:border-[#a88563]{% endif %}" style="background: {{ m[2] }};"></span>
            <span class="text-[9px] tracking-[0.2em] uppercase font-semibold text-[#666] group-hover:text-[#1a1208] transition-colors">{{ m[1] }}</span>
          </button>
          {% endfor %}
        </div>
      </div>

      <!-- CTAs: Join Waitlist + Enquire Now -->
      <div class="flex flex-col sm:flex-row gap-3 mb-10">
        <button data-enquire
          data-enquiry-type="waitlist"
          data-product-name="{{ product.name }}"
          data-product-slug="{{ product.slug }}"
          data-product-id="{{ product.id }}"
          data-title="Join the Waitlist · {{ product.name }}"
          data-metal-input="1"
          class="flex-1 px-8 sm:px-10 py-4 border border-[#1a1208] text-[#1a1208] hover:bg-[#1a1208] hover:text-white font-bold text-xs tracking-[0.3em] uppercase transition-colors text-center">
          Join Waitlist
        </button>
        <button data-enquire
          data-enquiry-type="product"
          data-product-name="{{ product.name }}"
          data-product-slug="{{ product.slug }}"
          data-product-id="{{ product.id }}"
          data-title="Enquire · {{ product.name }}"
          data-metal-input="1"
          class="flex-1 px-8 sm:px-10 py-4 sm:py-4 gold-gradient text-white font-bold text-xs tracking-[0.3em] uppercase shadow-lg hover:scale-[1.02] transition-transform text-center">
          Enquire Now
        </button>
      </div>

      <!-- Spec table -->
      <dl class="border-t border-[#E0D9CF] divide-y divide-[#E0D9CF] mb-8 md:mb-10">
        {% if product.metal %}<div class="grid grid-cols-3 py-3 md:py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Metal</dt><dd class="col-span-2 text-sm">{{ product.metal }}</dd></div>{% endif %}
        {% if product.stones %}<div class="grid grid-cols-3 py-3 md:py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Stones</dt><dd class="col-span-2 text-sm">{{ product.stones }}</dd></div>{% endif %}
        {% if product.carat_weight %}<div class="grid grid-cols-3 py-3 md:py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Carat</dt><dd class="col-span-2 text-sm">{{ product.carat_weight }}</dd></div>{% endif %}
        {% if product.dimensions %}<div class="grid grid-cols-3 py-3 md:py-4"><dt class="text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">Size</dt><dd class="col-span-2 text-sm">{{ product.dimensions }}</dd></div>{% endif %}
      </dl>

      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 text-[10px] tracking-[0.25em] uppercase font-bold text-[#444]">
        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-base">verified</span> Certified</div>
        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-base">handyman</span> Hand-finished</div>
        <div class="flex items-center gap-2"><span class="material-symbols-outlined text-primary text-base">eco</span> Ethical</div>
      </div>
    </div>
  </div>
</section>

{% if related.length %}
<section class="py-20 md:py-32 bg-surface-container-low border-y border-[#E0D9CF]">
  <div class="max-w-7xl mx-auto px-5 sm:px-6">
    <h2 class="text-3xl md:text-5xl font-headline italic mb-10 md:mb-16">You may also love</h2>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 sm:gap-6 md:gap-8">
      {% for p in related %}
      <a href="/products/{{ p.slug }}" class="group block">
        <div class="aspect-[4/5] overflow-hidden bg-white border border-[#E0D9CF]">
          {% if p.primary_image %}<img src="{{ p.primary_image }}" alt="{{ p.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"/>{% endif %}
        </div>
        <h3 class="text-base sm:text-lg md:text-xl font-headline italic mt-4 md:mt-6 leading-tight">{{ p.name }}</h3>
        <p class="text-primary text-[9px] sm:text-[10px] tracking-[0.3em] uppercase mt-2 md:mt-3 font-bold">View →</p>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
(function () {
  const car = document.querySelector('[data-carousel]');
  if (!car) return;
  const slides = car.querySelectorAll('[data-slide]');
  const dots = car.querySelectorAll('[data-carousel-dot]');
  const prev = car.querySelector('[data-carousel-prev]');
  const next = car.querySelector('[data-carousel-next]');
  const zoom = car.querySelector('[data-carousel-zoom]');
  let i = 0;
  let autoAdvance = null;
  function show(n) {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, idx) => { s.style.opacity = idx === i ? '1' : '0'; });
    dots.forEach((d, idx) => {
      d.classList.toggle('bg-primary', idx === i);
      d.classList.toggle('bg-[#E0D9CF]', idx !== i);
    });
  }
  prev && prev.addEventListener('click', (e) => { e.stopPropagation(); show(i - 1); });
  next && next.addEventListener('click', (e) => { e.stopPropagation(); show(i + 1); });
  dots.forEach((d) => d.addEventListener('click', () => show(Number(d.dataset.carouselDot))));
  if (slides.length > 1) autoAdvance = setInterval(() => show(i + 1), 6000);

  // --- Fullscreen lightbox on image click ---
  const lightbox = document.createElement('div');
  lightbox.className = 'fixed inset-0 z-50 bg-black/95 hidden items-center justify-center p-4 cursor-zoom-out';
  lightbox.innerHTML = `
    <button type="button" data-lb-close class="absolute top-4 right-4 w-11 h-11 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
      <span class="material-symbols-outlined">close</span>
    </button>
    <button type="button" data-lb-prev class="absolute left-3 sm:left-6 top-1/2 -translate-y-1/2 w-11 h-11 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
      <span class="material-symbols-outlined">chevron_left</span>
    </button>
    <button type="button" data-lb-next class="absolute right-3 sm:right-6 top-1/2 -translate-y-1/2 w-11 h-11 bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
      <span class="material-symbols-outlined">chevron_right</span>
    </button>
    <img data-lb-img alt="" class="max-h-[90vh] max-w-[92vw] object-contain" />
    <div data-lb-counter class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/70 text-xs tracking-[0.3em] uppercase font-bold"></div>
  `;
  document.body.appendChild(lightbox);
  const lbImg = lightbox.querySelector('[data-lb-img]');
  const lbCounter = lightbox.querySelector('[data-lb-counter]');
  const imgs = Array.from(slides).map((s) => s.src);

  function openLightbox(idx) {
    if (autoAdvance) { clearInterval(autoAdvance); autoAdvance = null; }
    setLightbox(idx);
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function setLightbox(idx) {
    i = (idx + imgs.length) % imgs.length;
    lbImg.src = imgs[i];
    lbCounter.textContent = `${i + 1} / ${imgs.length}`;
    show(i);
  }
  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }
  zoom && zoom.addEventListener('click', () => openLightbox(i));

  // --- Metal selector ---
  const metalSelector = document.querySelector('[data-metal-selector]');
  if (metalSelector) {
    metalSelector.querySelectorAll('[data-metal]').forEach((chip) => {
      chip.addEventListener('click', () => {
        metalSelector.querySelectorAll('[data-metal]').forEach((c) => {
          c.classList.remove('is-active');
          const sw = c.querySelector('span');
          sw && sw.classList.remove('border-[#1a1208]');
          sw && sw.classList.add('border-transparent');
        });
        chip.classList.add('is-active');
        const sw = chip.querySelector('span');
        sw && sw.classList.remove('border-transparent');
        sw && sw.classList.add('border-[#1a1208]');
      });
    });
  }

  // --- Inject metal preference + waitlist type into modal AFTER it opens ---
  document.querySelectorAll('[data-enquire][data-metal-input="1"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      setTimeout(() => {
        const modal = document.getElementById('enquiry-modal');
        if (!modal) return;
        const active = document.querySelector('[data-metal].is-active');
        const metalLabel = active ? active.dataset.metalLabel : '';
        const typeInput = modal.querySelector('input[name="enquiry_type"]');
        if (typeInput) typeInput.value = btn.dataset.enquiryType || 'product';
        const msgField = modal.querySelector('textarea[name="message"]');
        if (msgField && metalLabel) {
          const prefix = `Preferred metal: ${metalLabel}\n\n`;
          if (!msgField.value.startsWith('Preferred metal:')) {
            msgField.value = prefix + (msgField.value || '');
          }
        }
      }, 60);
    });
  });
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox || e.target === lbImg) closeLightbox();
  });
  lightbox.querySelector('[data-lb-close]').addEventListener('click', closeLightbox);
  lightbox.querySelector('[data-lb-prev]').addEventListener('click', (e) => { e.stopPropagation(); setLightbox(i - 1); });
  lightbox.querySelector('[data-lb-next]').addEventListener('click', (e) => { e.stopPropagation(); setLightbox(i + 1); });
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') setLightbox(i - 1);
    if (e.key === 'ArrowRight') setLightbox(i + 1);
  });
})();
</script>
{% endblock %}

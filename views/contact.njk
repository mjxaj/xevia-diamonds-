{% extends '_base.njk' %}
{% block content %}
<section class="py-14 sm:py-20 px-5 sm:px-6 max-w-5xl mx-auto">
  <p class="text-primary text-[10px] font-bold tracking-[0.3em] uppercase">Reach the Atelier</p>
  <h1 class="text-4xl sm:text-5xl md:text-7xl font-headline italic mt-3 sm:mt-4 mb-10 md:mb-16">Contact</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
    <div>
      <h3 class="text-xs tracking-[0.3em] uppercase font-bold text-primary mb-3">Email</h3>
      {% if site.contact_email %}<a href="mailto:{{ site.contact_email }}" class="text-base sm:text-lg font-headline italic hover:underline break-all">{{ site.contact_email }}</a>{% endif %}
    </div>
    <div>
      <h3 class="text-xs tracking-[0.3em] uppercase font-bold text-primary mb-3">Telephone</h3>
      {% if site.contact_phone %}<a href="tel:{{ site.contact_phone }}" class="text-base sm:text-lg font-headline italic hover:underline">{{ site.contact_phone }}</a>{% endif %}
    </div>
    <div>
      <h3 class="text-xs tracking-[0.3em] uppercase font-bold text-primary mb-3">Atelier</h3>
      <p class="text-base sm:text-lg font-headline italic">{{ site.contact_address }}</p>
    </div>
  </div>
  <div class="mt-14 md:mt-20 p-8 sm:p-12 bg-surface-container-low border border-[#E0D9CF] text-center">
    <p class="text-primary text-[10px] tracking-[0.3em] uppercase font-bold mb-3">For private viewings, commissions or press</p>
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-headline italic mb-5 sm:mb-6">Begin a Conversation</h2>
    <button data-enquire data-title="Get in Touch" class="w-full sm:w-auto px-10 sm:px-12 py-4 gold-gradient text-white font-bold text-xs tracking-[0.3em] uppercase shadow-md">Enquire Now</button>
  </div>
</section>
{% endblock %}

{% extends '_base.njk' %}
{% block content %}
<section class="pt-16 sm:pt-24 pb-10 sm:pb-16 px-5 sm:px-6 max-w-7xl mx-auto">
  <p class="text-primary text-[10px] font-bold tracking-[0.3em] uppercase">The Atelier</p>
  <h1 class="text-4xl sm:text-5xl md:text-7xl font-headline mt-3 sm:mt-4">The Collections</h1>
  <p class="text-[#444] mt-4 sm:mt-6 max-w-2xl font-light text-base sm:text-lg leading-relaxed">Browse our curated houses — from quiet brilliance to high jewellery — each a chapter in the {{ site.name }} story.</p>
</section>

{% for c in collections %}
<section class="py-12 md:py-20 px-5 sm:px-6 {% if loop.index % 2 == 0 %}bg-surface-container-low border-y border-[#E0D9CF]{% endif %}">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
    <div class="md:col-span-5">
      <span class="text-primary text-[10px] font-bold tracking-[0.3em] uppercase">{{ c.tagline }}</span>
      <h2 class="text-3xl sm:text-4xl md:text-6xl font-headline italic mt-3 md:mt-4 mb-4 md:mb-6">{{ c.name }}</h2>
      <p class="text-[#444] font-light leading-relaxed mb-6 md:mb-8 text-sm md:text-base">{{ c.description }}</p>
      <a href="/collections/{{ c.slug }}" class="inline-block text-xs tracking-[0.3em] uppercase font-bold text-primary border-b border-primary pb-1 hover:opacity-70 transition-opacity">View Collection →</a>
    </div>
    <div class="md:col-span-7 grid grid-cols-2 gap-3 sm:gap-4">
      {% for p in productsByCol[c.id] %}
      <a href="/products/{{ p.slug }}" class="aspect-square overflow-hidden bg-white border border-[#E0D9CF] block group">
        {% if p.primary_image %}<img src="{{ p.primary_image }}" alt="{{ p.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"/>{% endif %}
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endfor %}
{% endblock %}

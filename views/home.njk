{% extends '_base.njk' %}
{% block head %}
<style>
  .cream-bg { background-color: #f6ede0; }
  .cream-bg-soft { background-color: #faf3e7; }
  .ivory-bg { background-color: #fbf6ec; }
  .gold-text { color: #b8956a; }
  .gold-btn { background: linear-gradient(135deg, #c5a374 0%, #a88563 100%); }
  .gold-btn:hover { background: linear-gradient(135deg, #b8956a 0%, #9a7754 100%); }
  .serif-display { font-family: 'Noto Serif', serif; letter-spacing: -0.01em; }
  .hairline { display:inline-block; width: 64px; height: 1px; background: #b8956a; vertical-align: middle; }
  .prism { background-image: radial-gradient(ellipse at top right, rgba(255,240,210,0.5), transparent 60%), radial-gradient(ellipse at bottom left, rgba(245,225,195,0.4), transparent 50%); }
</style>
{% endblock %}
{% block content %}

<!-- ======================= HERO ======================= -->
<section class="relative cream-bg overflow-hidden -mt-16 sm:-mt-20 pt-24 sm:pt-32 pb-16 sm:pb-24 prism">
  <div class="absolute inset-0 z-0 opacity-60">
    <img src="/images/products/design-9-3.jpg" alt="" class="w-full h-full object-cover mix-blend-luminosity"/>
    <div class="absolute inset-0 bg-gradient-to-r from-[#f6ede0] via-[#f6ede0]/70 to-transparent"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[#f6ede0] via-transparent to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-5 sm:px-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center min-h-[70vh]">
    <div class="text-left">
      <h1 class="serif-display text-[#1a1208] text-6xl sm:text-7xl md:text-8xl leading-[0.9]">XEVIA</h1>
      <p class="text-[#a88563] text-xs sm:text-sm tracking-[0.5em] uppercase font-semibold mt-3">Diamonds</p>
      <div class="my-8"><span class="hairline"></span></div>
      <p class="serif-display text-2xl sm:text-3xl md:text-4xl text-[#1a1208] italic font-light leading-tight mb-4">Crafted To Captivate.</p>
      <p class="text-[#5e4a35] text-base sm:text-lg leading-relaxed mb-1">Not Just A Jewel.</p>
      <p class="text-[#5e4a35] text-base sm:text-lg leading-relaxed mb-10">A Feeling.</p>
      <a href="/collections" class="inline-block px-10 sm:px-12 py-4 sm:py-5 gold-btn text-white text-[10px] tracking-[0.35em] uppercase font-bold shadow-md transition-all">
        Discover The Collection
      </a>
    </div>
    <div class="relative hidden lg:block">
      <div class="aspect-square w-full max-w-[520px] ml-auto">
        <img src="/images/products/design-1-1.jpg" alt="Signature piece" class="w-full h-full object-cover shadow-2xl"/>
      </div>
    </div>
  </div>
</section>

<!-- ======================= PHILOSOPHY ======================= -->
<section class="cream-bg-soft py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
    <div class="ivory-bg p-10 md:p-16 flex flex-col justify-center">
      <p class="text-[#a88563] text-[10px] tracking-[0.45em] uppercase font-bold mb-8">The Xevia Philosophy</p>
      <h2 class="serif-display text-3xl sm:text-4xl md:text-5xl text-[#1a1208] leading-[1.1] mb-4">We do not<br/>create jewelry.</h2>
      <h3 class="serif-display italic font-light text-2xl sm:text-3xl md:text-4xl text-[#1a1208] leading-tight mb-8">We create moments<br/>that become heirlooms.</h3>
      <p class="text-[#5e4a35] text-sm leading-relaxed mb-8 max-w-md">At Xevia Diamonds, every piece is a reflection of timeless beauty, crafted with precision, passion, and a promise to be cherished forever.</p>
      <a href="/about" class="inline-flex items-center gap-3 text-[10px] tracking-[0.4em] uppercase font-bold text-[#1a1208] hover:gold-text transition-colors">
        Discover Our Story
        <span class="material-symbols-outlined text-base">add</span>
      </a>
    </div>
    <div class="relative aspect-[4/5] lg:aspect-auto lg:min-h-full overflow-hidden">
      <img src="/images/products/design-4-3.jpg" alt="Xevia philosophy" class="w-full h-full object-cover"/>
    </div>
  </div>
</section>

<!-- ======================= SIGNATURE COLLECTIONS ======================= -->
<section class="cream-bg py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-5 sm:px-10">
    <div class="flex items-center gap-4 mb-10 md:mb-14">
      <p class="text-[#a88563] text-[10px] tracking-[0.45em] uppercase font-bold">Signature Collections</p>
      <span class="material-symbols-outlined text-[#a88563] text-base">add</span>
    </div>
    {% set fallback = ['/images/products/design-1-1.jpg','/images/products/design-2-1.jpg','/images/products/design-9-1.jpg'] %}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
      {% for c in collections %}
        {% if loop.index <= 3 %}
        <a href="/collections/{{ c.slug }}" class="group relative block overflow-hidden aspect-[4/5]">
          <img src="{{ c.image_url | default(fallback[loop.index0]) }}" alt="{{ c.name }}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"/>
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white">
            <p class="serif-display text-2xl md:text-3xl leading-tight italic font-light">{{ c.name }}</p>
            <p class="text-[10px] tracking-[0.4em] uppercase font-semibold mt-2 opacity-90">Collection</p>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- ======================= PRECISION ======================= -->
<section class="cream-bg-soft py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div class="relative aspect-square overflow-hidden">
      <img src="/images/products/design-12-1.jpg" alt="Precision diamond" class="w-full h-full object-cover"/>
    </div>
    <div class="text-left lg:pl-10">
      <h2 class="serif-display italic font-light text-4xl sm:text-5xl md:text-6xl text-[#1a1208] leading-tight mb-6">
        Precision In<br/>Every Facet.
      </h2>
      <span class="hairline"></span>
      <p class="text-[#a88563] text-[10px] tracking-[0.45em] uppercase font-bold mt-8 mb-2">Exceptional Diamonds.</p>
      <p class="text-[#a88563] text-[10px] tracking-[0.45em] uppercase font-bold">Extraordinary You.</p>
    </div>
  </div>
</section>

<!-- ======================= CRAFTSMANSHIP PROCESS ======================= -->
<section class="cream-bg py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-5 sm:px-10">
    <div class="flex items-center gap-4 mb-12 md:mb-16">
      <p class="text-[#a88563] text-[10px] tracking-[0.45em] uppercase font-bold">The Xevia Craftsmanship</p>
      <span class="material-symbols-outlined text-[#a88563] text-base">add</span>
    </div>
    {% set steps = [
      ['diamond', 'Selection', 'Handpicked for brilliance & purity'],
      ['content_cut', 'Cutting', 'Precision cut to perfect every facet'],
      ['design_services', 'Setting', 'Expertly set for enduring beauty'],
      ['auto_awesome', 'Polishing', 'Finished to achieve timeless radiance'],
      ['favorite', 'Forever', 'Created to be cherished for generations']
    ] %}
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-y-12 gap-x-4 md:gap-x-0 relative">
      {% for s in steps %}
      <div class="text-center relative">
        <div class="flex justify-center mb-5">
          <div class="w-14 h-14 rounded-full border border-[#d4b88f] flex items-center justify-center">
            <span class="material-symbols-outlined text-[#a88563] text-2xl">{{ s[0] }}</span>
          </div>
        </div>
        <p class="text-[10px] tracking-[0.45em] uppercase font-bold text-[#1a1208] mb-3">{{ s[1] }}</p>
        <p class="text-xs leading-relaxed text-[#5e4a35] max-w-[160px] mx-auto">{{ s[2] }}</p>
        {% if not loop.last %}
        <div class="hidden md:flex absolute top-7 -right-2 lg:-right-4 text-[#d4b88f] items-center">
          <span class="material-symbols-outlined text-base">arrow_forward</span>
        </div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- ======================= LIFESTYLE GALLERY ======================= -->
<section class="cream-bg-soft py-2">
  <div class="grid grid-cols-2 md:grid-cols-5 gap-1">
    {% set gallery = [
      '/images/products/design-3-3.jpg',
      '/images/products/design-4-3.jpg',
      '/images/products/design-9-3.jpg',
      '/images/products/design-12-3.jpg',
      '/images/products/design-1-3.jpg'
    ] %}
    {% for img in gallery %}
    <div class="aspect-[4/5] overflow-hidden">
      <img src="{{ img }}" alt="" class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"/>
    </div>
    {% endfor %}
  </div>
</section>

<!-- ======================= EXPERIENCE ======================= -->
<section class="cream-bg py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-5 sm:px-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
    <div class="aspect-[4/5] overflow-hidden">
      <img src="/images/products/design-14-3.jpg" alt="Xevia experience" class="w-full h-full object-cover"/>
    </div>
    <div class="lg:pl-10">
      <p class="text-[#a88563] text-[10px] tracking-[0.45em] uppercase font-bold mb-6">The Xevia Experience</p>
      <h2 class="serif-display italic font-light text-3xl sm:text-4xl md:text-5xl text-[#1a1208] leading-tight mb-10">
        Every Xevia piece arrives<br/>as beautifully as it will<br/>be remembered.
      </h2>
      <button data-enquire data-title="Book Your Private Atelier Experience" class="inline-flex items-center gap-3 text-[10px] tracking-[0.45em] uppercase font-bold text-[#1a1208] hover:gold-text transition-colors border-b border-[#a88563] pb-2">
        Discover The Experience
        <span class="material-symbols-outlined text-base">add</span>
      </button>
    </div>
  </div>
</section>

<!-- ======================= TESTIMONIALS ======================= -->
<section class="cream-bg-soft py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-5 sm:px-10">
    <div class="flex items-center justify-center gap-4 mb-12 md:mb-16">
      <p class="text-[#a88563] text-[10px] tracking-[0.45em] uppercase font-bold">Stories That Shine</p>
      <span class="material-symbols-outlined text-[#a88563] text-base">add</span>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-16">
      {% set stories = [
        ['He proposed with a Xevia ring. The moment felt suspended in light.', 'Ananya S.'],
        ['It’s not just the sparkle, it’s the feeling it holds.', 'Meghna R.'],
        ['Timeless elegance, crafted with so much love.', 'Priyanka D.']
      ] %}
      {% for s in stories %}
      <div class="text-center">
        <span class="serif-display text-5xl text-[#b8956a] leading-none block">&ldquo;</span>
        <p class="serif-display italic font-light text-lg sm:text-xl text-[#1a1208] leading-relaxed my-3">
          {{ s[0] }}
        </p>
        <span class="serif-display text-5xl text-[#b8956a] leading-none block rotate-180 inline-block">&rdquo;</span>
        <p class="text-[10px] tracking-[0.4em] uppercase font-bold text-[#5e4a35] mt-3">— {{ s[1] }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Floating Book Consultation (mobile-friendly FAB, repurposes enquiry modal) -->
<button data-enquire data-title="Book a Private Consultation" class="fixed bottom-24 md:bottom-8 right-5 md:right-8 w-14 h-14 md:w-16 md:h-16 gold-btn rounded-full shadow-2xl flex items-center justify-center text-white hover:scale-110 transition-transform z-30 group">
  <span class="material-symbols-outlined text-2xl md:text-3xl">event_available</span>
  <span class="hidden md:inline absolute right-20 bg-[#1a1208] text-white px-4 py-2 text-[10px] tracking-widest uppercase opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap shadow-xl">Book Consultation</span>
</button>

{% endblock %}

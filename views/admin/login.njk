<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>Admin Login — {{ site.name }}</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;800&family=Noto+Serif:ital@0;1&display=swap" rel="stylesheet"/>
<style>body{font-family:'Manrope',sans-serif;background:#101010;color:#FFF8F0} h1,h2,.serif{font-family:'Noto Serif',serif}</style>
</head>
<body class="min-h-screen flex items-center justify-center px-6">
<div class="w-full max-w-sm">
  <div class="text-center mb-12">
    <div class="text-2xl serif tracking-[0.3em] uppercase">{{ site.name }}</div>
    <div class="text-[10px] tracking-[0.3em] uppercase text-[#C5A384] mt-2">Atelier Admin</div>
  </div>
  {% if error %}<div class="mb-6 px-4 py-3 bg-red-900/30 border border-red-500/40 text-red-200 text-sm">{{ error }}</div>{% endif %}
  <form method="POST" action="/admin/login" class="space-y-5">
    <div>
      <label class="block text-[10px] tracking-[0.3em] uppercase font-bold text-[#FFF8F0]/60 mb-2">Email</label>
      <input name="email" type="email" required autofocus class="w-full bg-transparent border-b border-white/30 px-1 py-3 focus:border-[#C5A384] focus:ring-0 text-sm"/>
    </div>
    <div>
      <label class="block text-[10px] tracking-[0.3em] uppercase font-bold text-[#FFF8F0]/60 mb-2">Password</label>
      <input name="password" type="password" required class="w-full bg-transparent border-b border-white/30 px-1 py-3 focus:border-[#C5A384] focus:ring-0 text-sm"/>
    </div>
    <button type="submit" class="w-full bg-[#C5A384] text-[#101010] py-3 text-xs tracking-[0.3em] uppercase font-bold mt-8">Enter Atelier</button>
  </form>
  <p class="text-center text-[10px] tracking-widest uppercase text-[#FFF8F0]/40 mt-12"><a href="/" class="hover:text-[#C5A384]">← Return to site</a></p>
</div>
</body>
</html>

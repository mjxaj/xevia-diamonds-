<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{ title | default('Admin') }} — {{ site.name }} Admin</title>
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;600;800&family=Noto+Serif:ital@0;1&family=Material+Symbols+Outlined&display=swap" rel="stylesheet"/>
<style>body{font-family:'Manrope',sans-serif;background:#FFF8F0;color:#101010} .serif,h1,h2,h3{font-family:'Noto Serif',serif} .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 300,'GRAD' 0,'opsz' 24}</style>
</head>
<body class="min-h-screen flex">
<aside class="w-64 bg-[#101010] text-[#FFF8F0] flex flex-col min-h-screen">
  <div class="p-8">
    <div class="text-xl serif tracking-[0.3em] uppercase">{{ site.name }}</div>
    <div class="text-[10px] tracking-[0.3em] uppercase text-[#C5A384] mt-2">Atelier Admin</div>
  </div>
  <nav class="flex-1 flex flex-col gap-1 px-4">
    {% set nav = [
      ['/admin', 'space_dashboard', 'Dashboard'],
      ['/admin/enquiries', 'mark_email_unread', 'Enquiries'],
      ['/admin/products', 'diamond', 'Products'],
      ['/admin/collections', 'collections_bookmark', 'Collections'],
      ['/admin/settings', 'settings', 'Site Settings']
    ] %}
    {% for n in nav %}
    <a href="{{ n[0] }}" class="flex items-center gap-3 px-4 py-3 text-sm tracking-wider {% if currentPath == n[0] or (n[0] != '/admin' and currentPath.startsWith(n[0])) %}bg-[#C5A384] text-[#101010] font-bold{% else %}text-[#FFF8F0]/70 hover:bg-white/5 hover:text-[#FFF8F0]{% endif %}">
      <span class="material-symbols-outlined text-base">{{ n[1] }}</span>{{ n[2] }}
    </a>
    {% endfor %}
  </nav>
  <div class="p-4 border-t border-white/10">
    <a href="/" target="_blank" class="block px-4 py-2 text-[10px] tracking-[0.3em] uppercase text-[#FFF8F0]/60 hover:text-[#C5A384]">↗ View site</a>
    <form method="POST" action="/admin/logout"><button class="w-full text-left px-4 py-2 text-[10px] tracking-[0.3em] uppercase text-[#FFF8F0]/60 hover:text-[#C5A384]">Logout</button></form>
  </div>
</aside>

<main class="flex-1 p-10">
{% if flash %}
<div class="mb-6 px-6 py-3 text-sm {% if flash.type == 'error' %}bg-red-50 border-l-4 border-red-500 text-red-900{% else %}bg-emerald-50 border-l-4 border-emerald-500 text-emerald-900{% endif %}">
  {{ flash.message }}
</div>
{% endif %}

{% block content %}{% endblock %}
</main>
</body>
</html>

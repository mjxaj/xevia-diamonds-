{% extends 'admin/_layout.njk' %}
{% block content %}
<h1 class="text-4xl serif italic mb-2">Dashboard</h1>
<p class="text-sm text-[#444] mb-10">An overview of the atelier.</p>

<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
  {% set cards = [
    ['New enquiries', totals.new_enquiries, 'mark_email_unread', '/admin/enquiries?status=new'],
    ['Total enquiries', totals.enquiries, 'inventory_2', '/admin/enquiries'],
    ['Live products', totals.products, 'diamond', '/admin/products'],
    ['Subscribers', totals.subscribers, 'mail', null]
  ] %}
  {% for c in cards %}
  <a href="{{ c[3] or '#' }}" class="p-6 bg-white border border-[#E0D9CF] hover:border-[#C5A384] transition-colors block">
    <span class="material-symbols-outlined text-[#C5A384]">{{ c[2] }}</span>
    <div class="text-4xl serif mt-4">{{ c[1] }}</div>
    <div class="text-[10px] tracking-[0.3em] uppercase font-bold text-[#444] mt-2">{{ c[0] }}</div>
  </a>
  {% endfor %}
</div>

<div class="bg-white border border-[#E0D9CF]">
  <div class="px-6 py-4 border-b border-[#E0D9CF] flex justify-between items-center">
    <h2 class="text-xl serif italic">Recent enquiries</h2>
    <a href="/admin/enquiries" class="text-[10px] tracking-[0.3em] uppercase font-bold text-[#C5A384]">View all →</a>
  </div>
  {% if recent.length %}
  <table class="w-full text-sm">
    <thead class="text-[10px] tracking-[0.3em] uppercase font-bold text-[#444] bg-[#faf4ed]">
      <tr><th class="text-left px-6 py-3">Ref</th><th class="text-left px-6 py-3">Name</th><th class="text-left px-6 py-3">Product</th><th class="text-left px-6 py-3">Status</th><th class="text-left px-6 py-3">When</th></tr>
    </thead>
    <tbody>
      {% for e in recent %}
      <tr class="border-t border-[#E0D9CF] hover:bg-[#faf4ed]">
        <td class="px-6 py-4"><a href="/admin/enquiries/{{ e.id }}" class="text-[#C5A384] font-bold">{{ e.reference }}</a></td>
        <td class="px-6 py-4">{{ e.name }}<div class="text-xs text-[#444]">{{ e.email }}</div></td>
        <td class="px-6 py-4 text-[#444]">{{ e.product_name | default('—') }}</td>
        <td class="px-6 py-4"><span class="px-2 py-1 text-[10px] uppercase tracking-widest font-bold {% if e.status == 'new' %}bg-amber-100 text-amber-800{% elif e.status == 'contacted' %}bg-blue-100 text-blue-800{% elif e.status == 'closed' %}bg-emerald-100 text-emerald-800{% else %}bg-gray-100 text-gray-700{% endif %}">{{ e.status }}</span></td>
        <td class="px-6 py-4 text-xs text-[#444]">{{ e.created_at | date }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  {% else %}
  <div class="p-12 text-center text-[#444] italic">No enquiries yet.</div>
  {% endif %}
</div>
{% endblock %}

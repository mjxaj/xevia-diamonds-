<!DOCTYPE html>
<html class="light" lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>{% if title %}{{ title }} — {% endif %}{{ site.name }} | {{ site.tagline }}</title>
<meta name="description" content="{{ site.name }} — {{ site.tagline }}. {{ settings.about_body | default('Heritage atelier of fine jewellery, est. ' + site.established) }}"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,300;0,400;0,700;1,400&amp;family=Manrope:wght@300;400;600;800&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<style>
  .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24; }
  body { font-family: 'Manrope', sans-serif; background-color: #FFF8F0; color: #101010; min-height: 100dvh; overflow-x: hidden; }
  .safe-bottom { padding-bottom: max(1rem, env(safe-area-inset-bottom)); }
  img { max-width: 100%; height: auto; }

  /* Warm gold-satin tray — matches the requested champagne backdrop */
  .gold-satin {
    background-color: #d9b87a;
    background-image:
      radial-gradient(ellipse 60% 45% at 22% 15%, rgba(255,247,221,0.85), transparent 65%),
      radial-gradient(ellipse 55% 40% at 78% 22%, rgba(255,234,184,0.55), transparent 60%),
      radial-gradient(ellipse 70% 50% at 60% 85%, rgba(160,118,60,0.45), transparent 65%),
      radial-gradient(ellipse 35% 25% at 35% 60%, rgba(255,255,255,0.30), transparent 70%),
      linear-gradient(155deg, #f3dca5 0%, #d3a464 45%, #b07f3e 100%);
    background-blend-mode: screen, screen, multiply, screen, normal;
  }
  /* shimmery moving light — purely decorative */
  .gold-satin::before {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(115deg, transparent 35%, rgba(255,250,225,0.35) 50%, transparent 65%);
    mix-blend-mode: screen;
  }
  .gold-satin-frame { position: relative; isolation: isolate; }
  .gold-satin-frame .gold-satin { position: absolute; inset: 0; z-index: 0; }
  .gold-satin-frame > *:not(.gold-satin) { position: relative; z-index: 1; }
  /* card-style: image floats on the gold tray with a soft inner shadow */
  .satin-card {
    position: relative; isolation: isolate; overflow: hidden;
    background-color: #d9b87a;
    background-image:
      radial-gradient(ellipse 60% 45% at 22% 15%, rgba(255,247,221,0.85), transparent 65%),
      radial-gradient(ellipse 55% 40% at 78% 22%, rgba(255,234,184,0.55), transparent 60%),
      radial-gradient(ellipse 70% 50% at 60% 85%, rgba(160,118,60,0.45), transparent 65%),
      radial-gradient(ellipse 35% 25% at 35% 60%, rgba(255,255,255,0.30), transparent 70%),
      linear-gradient(155deg, #f3dca5 0%, #d3a464 45%, #b07f3e 100%);
    background-blend-mode: screen, screen, multiply, screen, normal;
  }
  .satin-card > img { transition: transform .7s ease; }
  .satin-card.blend > img { mix-blend-mode: multiply; }
  h1, h2, h3, .serif { font-family: 'Noto Serif', serif; }
  .gold-gradient { background: linear-gradient(135deg, #C5A384 0%, #a88563 100%); }
  .glass-panel { background: rgba(255, 248, 240, 0.85); backdrop-filter: blur(20px); }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  [x-cloak] { display: none !important; }
</style>
<script id="tailwind-config">
  tailwind.config = {
    darkMode: 'class',
    theme: { extend: {
      colors: {
        'secondary':'#C5A384','primary-container':'#E0D9CF','on-secondary-fixed-variant':'#101010',
        'on-tertiary':'#FFF8F0','on-surface':'#101010','surface-container':'#f2ebe3',
        'background':'#FFF8F0','surface-container-low':'#faf4ed','surface-container-high':'#e8e1d9',
        'surface-container-lowest':'#FFFFFF','on-surface-variant':'#444444','outline-variant':'#E0D9CF',
        'primary':'#C5A384','surface':'#FFF8F0','on-primary':'#FFF8F0','surface-bright':'#FFFFFF'
      },
      borderRadius: { 'DEFAULT':'0rem','lg':'0rem','xl':'0rem','full':'9999px' },
      fontFamily: { 'headline':['Noto Serif'],'body':['Manrope'],'label':['Manrope'] }
    }}
  }
</script>
{% block head %}{% endblock %}
</head>
<body class="bg-surface text-on-surface selection:bg-primary/30">

{% include 'partials/header.njk' %}

{% if flash %}
<div id="flash" class="fixed top-24 left-1/2 -translate-x-1/2 z-50 px-6 py-3 shadow-lg
  {% if flash.type == 'error' %}bg-red-50 text-red-900 border border-red-200{% else %}bg-[#101010] text-[#FFF8F0]{% endif %}
  text-xs tracking-widest uppercase font-bold">
  {{ flash.message }}
</div>
<script>setTimeout(()=>document.getElementById('flash')?.remove(), 5000)</script>
{% endif %}

<main>
{% block content %}{% endblock %}
</main>

{% include 'partials/footer.njk' %}
{% include 'partials/enquiry-modal.njk' %}
{% include 'partials/mobile-nav.njk' %}

<script>
// --- Enquiry modal ---
(function () {
  const modal = document.getElementById('enquiry-modal');
  if (!modal) return;
  const form = modal.querySelector('form');
  const productNameField = modal.querySelector('[data-product-name]');
  const productInput = modal.querySelector('input[name="product_slug"]');
  const productIdInput = modal.querySelector('input[name="product_id"]');
  const titleEl = modal.querySelector('[data-modal-title]');
  const closeBtns = modal.querySelectorAll('[data-close-modal]');
  const result = modal.querySelector('[data-modal-result]');
  const formWrap = modal.querySelector('[data-modal-form-wrap]');

  function open(payload) {
    payload = payload || {};
    productNameField.textContent = payload.productName || '';
    productInput.value = payload.productSlug || '';
    productIdInput.value = payload.productId || '';
    titleEl.textContent = payload.title || 'Enquire Now';
    formWrap.classList.remove('hidden');
    result.classList.add('hidden');
    form.reset();
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  }
  function close() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }
  closeBtns.forEach((b) => b.addEventListener('click', close));
  modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

  document.querySelectorAll('[data-enquire]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      open({
        productName: btn.dataset.productName,
        productSlug: btn.dataset.productSlug,
        productId: btn.dataset.productId,
        title: btn.dataset.title || 'Enquire Now',
      });
    });
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());
    try {
      const res = await fetch('/enquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', Accept: 'application/json' },
        body: new URLSearchParams(payload).toString(),
      });
      const json = await res.json();
      if (json.ok) {
        result.innerHTML = `
          <div class="text-center py-8 px-4">
            <span class="material-symbols-outlined text-primary text-5xl mb-4">auto_awesome</span>
            <h3 class="text-2xl font-headline italic mb-3">Thank you</h3>
            <p class="text-sm text-[#444] mb-2">${json.message}</p>
            <p class="text-xs tracking-widest uppercase font-bold text-primary mt-6">Ref · ${json.reference}</p>
            <button type="button" data-close-modal class="mt-8 text-xs tracking-widest uppercase font-bold underline">Close</button>
          </div>`;
        result.querySelectorAll('[data-close-modal]').forEach((b) => b.addEventListener('click', close));
        formWrap.classList.add('hidden');
        result.classList.remove('hidden');
      } else {
        alert(json.error || 'Something went wrong.');
      }
    } catch (err) {
      alert('Network error. Please try again.');
    }
  });
})();
</script>
{% block scripts %}{% endblock %}
</body>
</html>
